{
  "name": "umbo-mobile-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run release && vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "vite",
    "build": "vite build",
    "release": "npm run build -- --mode production",
    "preview": "vite preview",
    "test": "node --test tests/model.test.js && npm run build && npm run test:e2e",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:unit": "node --test tests/model.test.js",
    "test:setup": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --no-shell chromium"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
